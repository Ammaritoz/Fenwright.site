# --- AI (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=

# --- SMS via Telnyx (server-side only) ---
# portal.telnyx.com -> API Keys
TELNYX_API_KEY=
# Sending identity. Either an E.164 number you own (required for two-way SMS —
# only a real number can receive replies), or an alphanumeric sender ID for
# one-way sends, which cannot be replied to.
TELNYX_FROM_NUMBER=
# Required when TELNYX_FROM_NUMBER is an alphanumeric sender ID; optional for a
# plain number. portal.telnyx.com -> Messaging -> Messaging Profiles
TELNYX_MESSAGING_PROFILE_ID=
# Optional: set to "1" to run Telnyx Number Lookup on demo-text numbers (adds cost)
TELNYX_LOOKUP=

# --- Airtable CRM / logging ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Rate limiting (Upstash Redis, free tier) ---
# If absent, the app falls back to an in-memory limiter for local dev only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo abuse controls ---
DEMO_SMS_DAILY_CAP=100
# Optional: global daily cap on /api/demo-reply (AI-only, no SMS). Defaults to
# 2000 if unset.
DEMO_REPLY_DAILY_CAP=2000
# Optional: global daily cap on /api/contact (real SMS + Anthropic). Defaults to
# 200 if unset. Backstop against an attacker rotating IPs and phone numbers.
CONTACT_DAILY_CAP=200

# --- Optional: extra origins allowed to call the API routes ---
# Comma-separated full origins, e.g. https://staging.fenwright.ie
# The site's own origin is always allowed; leave blank unless you need another.
ALLOWED_ORIGINS=

# --- Optional: forward contact leads to an n8n webhook (best effort) ---
N8N_WEBHOOK_URL=

# --- Cal.com booking (public, used by the embed) ---
# username/event-slug, e.g. fenwright/30min
CALCOM_LINK=fenwright/30min
NEXT_PUBLIC_CALCOM_LINK=fenwright/30min
# Embed origin: https://app.cal.eu for Cal's EU cloud, https://app.cal.com for the default cloud
NEXT_PUBLIC_CALCOM_ORIGIN=https://app.cal.eu
NEXT_PUBLIC_CALCOM_BOOKING_BASE=https://cal.eu

# --- Google Analytics (public, only loads after cookie-consent accept) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Voice receptionist ---
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=
# Shared secret for signing tool webhooks. Generate: openssl rand -hex 32
VOICE_WEBHOOK_SECRET=
# Public base URL Vapi calls back into, e.g. https://www.fenwright.ie
VOICE_PUBLIC_BASE_URL=
# Cal.com API v2
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Optional: global daily cap on SMS sent by the voice tools (real Twilio spend).
# Defaults to 100 if unset. The per-call limits are keyed on a callId that
# arrives in the request body, so this is the only limit a sender cannot
# restart by inventing a new id. It caps the text, never the booking: past the
# cap the assistant still books and simply says no confirmation text went out.
VOICE_SMS_DAILY_CAP=100
